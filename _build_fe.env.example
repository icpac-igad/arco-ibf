# _build_fe.env — configuration for _build_fe.sh
# Copy to _build_fe.env and fill in your values.
# This file is gitignored (contains project IDs and paths).

# GCP project ID
PROJECT="e4drr-crafd"

# Cloud Run API service URL (get from: gcloud run services describe crma-api --region=us-central1 --format='value(status.url)')
API_URL="https://crma-api-462481537368.us-central1.run.app"

# Full resource name of the FE deployer service account (for --service-account flag)
FE_SA="projects/e4drr-crafd/serviceAccounts/crma-fe-deployer@e4drr-crafd.iam.gserviceaccount.com"

# Path to the FE deployer SA key JSON file
FE_KEY="/data/08-2023/working_notes_jupyter/ignore_nka_gitrepos/cno-e4drr/devops/crma-fe-cr/service_account/crma-fe-deployer-key.json"

# Path to the arco-ibf Next.js source repo
ARCO_IBF="/data/08-2023/working_notes_jupyter/ignore_nka_gitrepos/pam_team/crma/arco-ibf"

# Path to the crma-fe-cr devops folder (contains Dockerfile + cloudbuild.yaml)
FE_DEVOPS="/data/08-2023/working_notes_jupyter/ignore_nka_gitrepos/cno-e4drr/devops/crma-fe-cr"

# Temp directory used for build context (wiped on each run)
BUILD_DIR="/tmp/crma-fe-build"
